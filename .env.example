# 服务端口配置
BACKEND_PORT=8000
FRONTEND_PORT=5173

# LLM 配置
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=your-llm-url
LLM_MODEL=your-model
EMBEDDING_MODEL=your-embedding-model

# 服务配置
DEBUG=False

# 管理后台令牌（生产环境必填）：前端访问「管理后台」时需输入，
# 后端校验 X-Admin-Token 请求头。留空则管理接口无鉴权（仅限本地开发）。
ADMIN_TOKEN=your-admin-token

# （可选）api_key 加密密钥。不设置则自动生成并保存到 backend/data/.encryption_key。
# 生产环境建议显式设置并妥善保管，丢失后已加密的模型 api_key 无法解密。
API_KEY_ENCRYPTION_KEY=

# （可选）Langfuse 可观测性。密钥留空则监控自动关闭，不影响业务功能
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=True

# （可选）可靠性：重试次数 / 熔断阈值与冷却秒数 / 对话限流（次、窗口秒数）
LLM_MAX_RETRIES=3
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_SECONDS=60
CHAT_RATE_LIMIT_MAX_CALLS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
